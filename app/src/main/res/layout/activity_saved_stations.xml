<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/saved_stations_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- ===== TOP APP BAR ===== -->
    <RelativeLayout
        android:id="@+id/rl_saved_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="#F8FAFC"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Circular Back Button -->
        <ImageView
            android:id="@+id/btn_saved_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="Back"
            android:padding="10dp"
            android:elevation="2dp"
            app:tint="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_saved_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_saved_back"
            android:layout_marginStart="14dp"
            android:layout_centerVertical="true"
            android:text="Saved Stations"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Circular More Vert Button (⋮) -->
        <ImageView
            android:id="@+id/btn_saved_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Options"
            android:padding="9dp"
            android:elevation="2dp"
            app:tint="#1E293B"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- ===== SEARCH INPUT BAR ===== -->
    <LinearLayout
        android:id="@+id/ll_saved_search_box"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_input_white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="1dp"
        app:layout_constraintTop_toBottomOf="@id/rl_saved_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search_lens"
            android:contentDescription="Search"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/et_search_saved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="Search your saved stations..."
            android:textColorHint="#94A3B8"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:singleLine="true"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- ===== MAIN SCROLLABLE CONTENT ===== -->
    <ScrollView
        android:id="@+id/scroll_saved_stations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/ll_saved_search_box"
        app:layout_constraintBottom_toTopOf="@id/bottom_user_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp">

            <!-- ============================================ -->
            <!-- 1. FAVORITES SECTION -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Favorites"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_favorites_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- FAVORITE CARD 1: HOME -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_fav_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Home Blue Icon Box -->
                    <LinearLayout
                        android:id="@+id/ll_fav_home_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_box_blue"
                        android:gravity="center"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_home_saved"
                            android:contentDescription="Home"
                            app:tint="#2563EB" />
                    </LinearLayout>

                    <!-- Text Details -->
                    <LinearLayout
                        android:id="@+id/ll_fav_home_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ll_fav_home_icon"
                        android:layout_toStartOf="@id/iv_fav_home_arrow"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <!-- Name + Star -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_home_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="&#x2605;"
                                android:textColor="#F59E0B"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Subtitle Station -->
                        <TextView
                            android:id="@+id/tv_home_station"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Oakridge Gardens Station"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />

                        <!-- Distance pill & Next Train -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Distance Pill -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_distance"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:src="@drawable/ic_near_me_nav"
                                    android:contentDescription="Distance"
                                    app:tint="#475569" />

                                <TextView
                                    android:id="@+id/tv_home_distance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="1.2 km away"
                                    android:textColor="#475569"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <!-- Live Train arrival -->
                            <TextView
                                android:id="@+id/tv_home_next_train"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Next: 3 mins"
                                android:textColor="#EF4444"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Chevron Right -->
                    <ImageView
                        android:id="@+id/iv_fav_home_arrow"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Open"
                        app:tint="#CBD5E1"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAVORITE CARD 2: WORK -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_fav_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- Work Blue Icon Box -->
                    <LinearLayout
                        android:id="@+id/ll_fav_work_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_box_blue"
                        android:gravity="center"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_briefcase_work"
                            android:contentDescription="Work"
                            app:tint="#2563EB" />
                    </LinearLayout>

                    <!-- Text Details -->
                    <LinearLayout
                        android:id="@+id/ll_fav_work_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ll_fav_work_icon"
                        android:layout_toStartOf="@id/iv_fav_work_arrow"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp">

                        <!-- Name + Star -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_work_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Work"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="&#x2605;"
                                android:textColor="#F59E0B"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Subtitle Station -->
                        <TextView
                            android:id="@+id/tv_work_station"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Financial District North"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />

                        <!-- Distance pill & Next Train -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Distance Pill -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_distance"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="8dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:src="@drawable/ic_near_me_nav"
                                    android:contentDescription="Distance"
                                    app:tint="#475569" />

                                <TextView
                                    android:id="@+id/tv_work_distance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="4.8 km away"
                                    android:textColor="#475569"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>

                            <!-- Live Train arrival -->
                            <TextView
                                android:id="@+id/tv_work_next_train"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Next: 12 mins"
                                android:textColor="#2563EB"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Chevron Right -->
                    <ImageView
                        android:id="@+id/iv_fav_work_arrow"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Open"
                        app:tint="#CBD5E1"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ============================================ -->
            <!-- 2. RECENT SEARCHES SECTION -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Searches"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_recent_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear All"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_recent_searches_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- RECENT 1: Central Station -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_recent_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/ll_rec1_icon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_box_circle_grey"
                            android:gravity="center"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_train"
                                android:contentDescription="Station"
                                app:tint="#334155" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/ll_rec1_icon"
                            android:layout_toStartOf="@id/tv_rec1_time"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="8dp"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/tv_rec1_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Central Station"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Hub for all Metro lines"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_rec1_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24 min ago"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- RECENT 2: Airport Terminal 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_recent_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/ll_rec2_icon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_box_circle_grey"
                            android:gravity="center"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_airplane_flight"
                                android:contentDescription="Airport"
                                app:tint="#334155" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/ll_rec2_icon"
                            android:layout_toStartOf="@id/tv_rec2_time"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="8dp"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/tv_rec2_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Airport Terminal 4"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="International Departures"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_rec2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1h ago"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- RECENT 3: University Park -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_recent_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/ll_rec3_icon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_box_circle_grey"
                            android:gravity="center"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_school_cap"
                                android:contentDescription="University"
                                app:tint="#334155" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toEndOf="@id/ll_rec3_icon"
                            android:layout_toStartOf="@id/tv_rec3_time"
                            android:layout_marginStart="14dp"
                            android:layout_marginEnd="8dp"
                            android:layout_centerVertical="true">

                            <TextView
                                android:id="@+id/tv_rec3_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="University Park"
                                android:textColor="#0F172A"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="East Campus Entrance"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_rec3_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yesterday"
                            android:textColor="#94A3B8"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== FLOATING ACTION BUTTON (+) ===== -->
    <LinearLayout
        android:id="@+id/fab_add_station"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_fab_circle_blue"
        android:elevation="8dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_user_nav"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="Add Station"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- ===== BOTTOM NAVIGATION BAR ===== -->
    <LinearLayout
        android:id="@+id/bottom_user_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TAB 1: HOME -->
        <LinearLayout
            android:id="@+id/nav_user_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Home"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- TAB 2: TICKETS -->
        <LinearLayout
            android:id="@+id/nav_user_tickets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_tickets"
                android:contentDescription="Tickets"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tickets"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- TAB 3: MAP -->
        <LinearLayout
            android:id="@+id/nav_user_map"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_map"
                android:contentDescription="Map"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Map"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- TAB 4: PROFILE (ACTIVE WITH RED DOT) -->
        <LinearLayout
            android:id="@+id/nav_user_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_profile"
                    android:contentDescription="Profile"
                    app:tint="#2563EB" />

                <!-- Red Notification Dot -->
                <View
                    android:id="@+id/view_profile_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_red_badge_dot" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Profile"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
