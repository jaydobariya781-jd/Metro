<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/otp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title: Verify OTP -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Verify OTP"
        android:textColor="#1A1A2E"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sent to label (plain) -->
    <TextView
        android:id="@+id/tv_sent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="24dp"
        android:text="Sent to "
        android:textColor="#888888"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Phone number (bold) -->
    <TextView
        android:id="@+id/tv_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="+91 98765 43210"
        android:textColor="#1A1A2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toEndOf="@id/tv_sent_label"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_sent_label" />

    <!-- Demo OTP Hint -->
    <TextView
        android:id="@+id/tv_demo_otp_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="24dp"
        android:text="Demo OTP: 123456"
        android:textColor="#0057B7"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/tv_sent_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- OTP Input Boxes Row -->
    <LinearLayout
        android:id="@+id/ll_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_demo_otp_hint">

        <!-- OTP Box 1 -->
        <EditText
            android:id="@+id/et_otp1"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- OTP Box 2 -->
        <EditText
            android:id="@+id/et_otp2"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- OTP Box 3 -->
        <EditText
            android:id="@+id/et_otp3"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- OTP Box 4 -->
        <EditText
            android:id="@+id/et_otp4"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- OTP Box 5 -->
        <EditText
            android:id="@+id/et_otp5"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- OTP Box 6 -->
        <EditText
            android:id="@+id/et_otp6"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_otp_box_inactive"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="#1A1A2E"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- OTP Error Message View -->
    <TextView
        android:id="@+id/tv_otp_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Please enter a valid 6-digit OTP"
        android:textColor="#EF4444"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ll_otp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_verify"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="Verify &amp; Proceed"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_btn_next"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/tv_otp_error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Resend OTP row -->
    <LinearLayout
        android:id="@+id/ll_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/btn_verify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_resend_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend OTP in "
            android:textColor="#888888"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:30"
            android:textColor="#1A56C4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
