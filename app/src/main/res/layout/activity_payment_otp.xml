<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/payment_otp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Header Bar -->
    <RelativeLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Verify OTP"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp">

            <!-- Center Phone Icon Circle -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#F0F4FD">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="#0052CC"
                    android:contentDescription="OTP Phone" />
            </FrameLayout>

            <!-- Subtitle Text -->
            <TextView
                android:id="@+id/tv_subtitle_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Sent to +91 98765 43210 to confirm payment"
                android:textColor="#667085"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tv_subtitle_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="of ₹25.00"
                android:textColor="#1A1A2E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- 4 OTP Input Boxes Row -->
            <LinearLayout
                android:id="@+id/ll_otp_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- OTP Box 1 -->
                <EditText
                    android:id="@+id/et_otp1"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:maxLength="1"
                    android:inputType="number"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:background="@drawable/bg_otp_box_inactive"
                    android:fontFamily="sans-serif-medium" />

                <!-- OTP Box 2 -->
                <EditText
                    android:id="@+id/et_otp2"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:maxLength="1"
                    android:inputType="number"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:background="@drawable/bg_otp_box_inactive"
                    android:fontFamily="sans-serif-medium" />

                <!-- OTP Box 3 -->
                <EditText
                    android:id="@+id/et_otp3"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:maxLength="1"
                    android:inputType="number"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:background="@drawable/bg_otp_box_inactive"
                    android:fontFamily="sans-serif-medium" />

                <!-- OTP Box 4 -->
                <EditText
                    android:id="@+id/et_otp4"
                    android:layout_width="56dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:maxLength="1"
                    android:inputType="number"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:background="@drawable/bg_otp_box_inactive"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <!-- OTP Error Message View -->
            <TextView
                android:id="@+id/tv_otp_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Please enter a valid 4-digit OTP"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <!-- Resend Timer -->
            <LinearLayout
                android:id="@+id/ll_resend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend OTP in "
                    android:textColor="#667085"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:30"
                    android:textColor="#0052CC"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Sticky Action Bar -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_verify_pay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔒  Verify &amp; Pay ₹25.00"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_btn_pill_blue"
            android:stateListAnimator="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
