<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/admin_users_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDE1E5">

    <!-- ===== TOP BAR ===== -->
    <LinearLayout
        android:id="@+id/ll_admin_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#DDE1E5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_admin_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Admin"
            android:textColor="#7C3AED"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <!-- Notification Bell -->
        <ImageView
            android:id="@+id/iv_admin_bell"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notifications"
            android:padding="6dp"
            android:layout_marginEnd="12dp"
            app:tint="#334155"
            android:clickable="true"
            android:focusable="true" />

        <!-- Profile Avatar -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_admin_profile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/user_avatar"
            app:civ_border_width="2dp"
            app:civ_border_color="#CBD5E1"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ===== MAIN CONTENT BODY (WHITE CONTAINER) ===== -->
    <ScrollView
        android:id="@+id/scroll_users_body"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/ll_admin_header"
        app:layout_constraintBottom_toTopOf="@id/bottom_admin_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp">

            <!-- User Management Header -->
            <TextView
                android:id="@+id/tv_users_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Management"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_users_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Manage and monitor application users."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

            <!-- ===== SEARCH BAR & FILTER ROW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Search Input Container (Light Pink) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input_pink"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search_lens"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/et_search_users"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="Search by name, email..."
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch" />
                </LinearLayout>

                <!-- Filter Button -->
                <ImageView
                    android:id="@+id/btn_filter_users"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_filter_button"
                    android:src="@drawable/ic_filter_sliders"
                    android:contentDescription="Filter users"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ===== + ADD NEW USER BUTTON ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_new_user"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:text="+ Add New User"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:backgroundTint="#00478F"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- ===== USERS LIST CONTAINER ===== -->
            <LinearLayout
                android:id="@+id/ll_users_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ===== PAGINATION CONTROLS ===== -->
            <LinearLayout
                android:id="@+id/ll_pagination_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Prev Button (<) -->
                <TextView
                    android:id="@+id/btn_page_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_page_inactive_white"
                    android:gravity="center"
                    android:text="&lt;"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Page 1 Button (Active) -->
                <TextView
                    android:id="@+id/btn_page_1"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_page_active_blue"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Page 2 Button -->
                <TextView
                    android:id="@+id/btn_page_2"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_page_inactive_white"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Page 3 Button -->
                <TextView
                    android:id="@+id/btn_page_3"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_page_inactive_white"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <!-- Next Button (>) -->
                <TextView
                    android:id="@+id/btn_page_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_page_inactive_white"
                    android:gravity="center"
                    android:text="&gt;"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM NAVIGATION BAR ===== -->
    <LinearLayout
        android:id="@+id/bottom_admin_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#DDE1E5"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TAB 1: HOME (INACTIVE) -->
        <LinearLayout
            android:id="@+id/nav_admin_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Home"
                app:tint="#1D4ED8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- TAB 2: USERS (ACTIVE PILL) -->
        <LinearLayout
            android:id="@+id/nav_admin_users"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_active_pill"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_users_group"
                    android:contentDescription="Users"
                    app:tint="#0057B7" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Users"
                android:textColor="#0057B7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- TAB 3: SETTINGS (INACTIVE) -->
        <LinearLayout
            android:id="@+id/nav_admin_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings_gear"
                android:contentDescription="Settings"
                app:tint="#1D4ED8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Settings"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
