<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/book_qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/ll_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Book QR Ticket"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/ll_topbar"
        app:layout_constraintBottom_toTopOf="@id/btn_pay_now"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp">

            <!-- ROUTE CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <!-- Vertical route icon -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_route_vertical"
                        android:contentDescription="Route"
                        android:layout_marginEnd="20dp"
                        android:scaleType="fitCenter" />

                    <!-- Station info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- FROM STATION -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FROM STATION"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/tv_from_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Thaltej"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_from_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Blue Line (East-West)"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="20dp" />

                        <!-- TO STATION -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TO STATION"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />

                            <TextView
                                android:id="@+id/tv_to_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Vastral Gam"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_to_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Blue Line (East-West)"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PASSENGER COUNT CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_passenger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSENGER COUNT"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="20dp" />

                    <!-- Adults row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adults"
                                android:textColor="#1A1A2E"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Age 12+"
                                android:textColor="#AAAAAA"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <!-- Counter control -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/btn_adults_minus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_minus"
                                android:background="@drawable/bg_btn_minus"
                                android:padding="10dp"
                                android:contentDescription="Decrease adults"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tv_adults_count"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center" />

                            <ImageView
                                android:id="@+id/btn_adults_plus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_plus"
                                android:background="@drawable/bg_btn_plus"
                                android:padding="10dp"
                                android:contentDescription="Increase adults"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Children row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Children"
                                android:textColor="#1A1A2E"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Age 3-12"
                                android:textColor="#AAAAAA"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>

                        <!-- Counter control -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/btn_children_minus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_minus"
                                android:background="@drawable/bg_btn_minus"
                                android:padding="10dp"
                                android:contentDescription="Decrease children"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/tv_children_count"
                                android:layout_width="40dp"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center" />

                            <ImageView
                                android:id="@+id/btn_children_plus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_plus"
                                android:background="@drawable/bg_btn_plus"
                                android:padding="10dp"
                                android:contentDescription="Increase children"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FARE SUMMARY CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_fare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FARE SUMMARY"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Base Fare row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tv_base_fare_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Base Fare (1 Adult)"
                            android:textColor="#555555"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tv_base_fare_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x20B9;23.00"
                            android:textColor="#1A1A2E"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Taxes row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Taxes &amp; Fees"
                            android:textColor="#555555"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tv_taxes_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x20B9;2.00"
                            android:textColor="#1A1A2E"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="16dp" />

                    <!-- Total row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"
                            android:textColor="#1A1A2E"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_total_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&#x20B9;25.00"
                            android:textColor="#1A56C4"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- PAY NOW BOTTOM BUTTON -->
    <LinearLayout
        android:id="@+id/btn_pay_now"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_pay_now"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Secure payment"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_pay_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pay &#x20B9;25.00 Now"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
