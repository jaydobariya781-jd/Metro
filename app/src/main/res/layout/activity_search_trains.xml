<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_trains_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">
    <LinearLayout
        android:id="@+id/ll_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Search Trains"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/ll_topbar"
        app:layout_constraintBottom_toTopOf="@id/btn_pay_now"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/card_route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">
                    <LinearLayout
                        android:id="@+id/ll_start"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_toStartOf="@id/btn_swap"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true">
                        <ImageView
                            android:id="@+id/iv_start_dot"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_route_dots"
                            android:contentDescription="Start point"
                            android:layout_marginEnd="14dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START POINT"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />
                            <TextView
                                android:id="@+id/tv_start_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Thaltej"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:id="@+id/tv_start_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Blue Line (East-West)"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btn_swap"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_swap_vert"
                        android:contentDescription="Swap"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true" />
                    <View
                        android:id="@+id/divider_route"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_below="@id/ll_start"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp" />
                    <LinearLayout
                        android:id="@+id/ll_end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_below="@id/divider_route"
                        android:layout_toStartOf="@id/btn_chevron"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:id="@+id/iv_end_dot"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_route_dots"
                            android:contentDescription="End point"
                            android:layout_marginEnd="14dp"
                            app:tint="#F09000" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="END POINT"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />
                            <TextView
                                android:id="@+id/tv_end_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Vastral Gam"
                                android:textColor="#1A1A2E"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:id="@+id/tv_end_line"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Blue Line (East-West)"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/btn_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Select"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/divider_route"
                        android:layout_alignTop="@id/ll_end"
                        android:layout_alignBottom="@id/ll_end"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/tv_suggested_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="14dp"
                android:layout_gravity="center_horizontal"
                android:text="SUGGESTED TRAINS"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:textStyle="bold" />
            <androidx.cardview.widget.CardView
                android:id="@+id/card_train1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_train_icon"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_train"
                                android:contentDescription="Train"
                                android:tint="#1A56C4" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/tv_train1_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Express 241"
                                android:textColor="#1A1A2E"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="DAILY SERVICE"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_train1_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ON TIME"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:background="@drawable/bg_badge_green"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_train1_depart_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:30"
                                android:textColor="#1A1A2E"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:id="@+id/tv_train1_depart_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thaltej"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:id="@+id/tv_train1_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42 mins"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:layout_gravity="center_horizontal" />
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp">
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#DDDDDD"
                                    android:layout_centerVertical="true" />
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_circle"
                                    android:layout_centerInParent="true" />
                            </RelativeLayout>
                            <TextView
                                android:id="@+id/tv_train1_stops"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Non-stop"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:layout_gravity="center_horizontal" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:id="@+id/tv_train1_arrive_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:12"
                                android:textColor="#1A1A2E"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end" />
                            <TextView
                                android:id="@+id/tv_train1_arrive_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vastral Gam"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_train1_fare"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="&#x20B9;25.00"
                            android:textColor="#1A56C4"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_book1"
                            android:layout_width="120dp"
                            android:layout_height="44dp"
                            android:text="Book Now"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:backgroundTint="#1A56C4"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_train2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_train_icon"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_train"
                                android:contentDescription="Train"
                                android:tint="#1A56C4" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:id="@+id/tv_train2_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Metro M-09"
                                android:textColor="#1A1A2E"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="STANDARD"
                                android:textColor="#AAAAAA"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="0.06" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_train2_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCHEDULED"
                            android:textColor="#888888"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.04"
                            android:background="@drawable/bg_badge_grey"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_train2_depart_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:45"
                                android:textColor="#1A1A2E"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:id="@+id/tv_train2_depart_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thaltej"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:id="@+id/tv_train2_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45 mins"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:layout_gravity="center_horizontal" />
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp">
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#DDDDDD"
                                    android:layout_centerVertical="true" />
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_circle"
                                    android:layout_centerInParent="true" />
                            </RelativeLayout>
                            <TextView
                                android:id="@+id/tv_train2_stops"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 stops"
                                android:textColor="#888888"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:layout_gravity="center_horizontal" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:id="@+id/tv_train2_arrive_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:30"
                                android:textColor="#1A1A2E"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="end" />
                            <TextView
                                android:id="@+id/tv_train2_arrive_station"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vastral Gam"
                                android:textColor="#888888"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_train2_fare"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="&#x20B9;25.00"
                            android:textColor="#1A56C4"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_book2"
                            android:layout_width="120dp"
                            android:layout_height="44dp"
                            android:text="Book Now"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:backgroundTint="#1A56C4"
                            app:cornerRadius="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/btn_pay_now"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_btn_pay_now"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Secure payment"
            android:layout_marginEnd="10dp" />
        <TextView
            android:id="@+id/tv_pay_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pay &#x20B9;25.00 Now"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
